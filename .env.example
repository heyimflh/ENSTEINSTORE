# ==============================================================================
# ENSTEINSTORE — Environment Variables Configuration Template
# Salin file ini menjadi .env sebelum menjalankan aplikasi.
# JANGAN PERNAH MENYIMPAN PASSWORD / SECRET ASLI KE DALAM GIT REPOSITORY!
# ==============================================================================

# Database PostgreSQL 18
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ensteinstore
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Spring Profile (dev | test | prod)
SPRING_PROFILES_ACTIVE=dev

# Server Port
SERVER_PORT=8080

# Spring Security & JWT Secret (HS256 min 256 bits, acak untuk produksi)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=28800000

# Akun Admin Awal (Seed)
ADMIN_SEED_EMAIL=admin@ensteinstore.com
ADMIN_SEED_PASSWORD=AdminEnstein2026!
ADMIN_SEED_NAME="Admin Toko Enstein"
ADMIN_SEED_CODE=ADM-001

# Konfigurasi Bisnis Toko
STORE_DELIVERY_FEE=15000
STORE_PAYMENT_EXPIRY_HOURS=24
STORE_SIMULATION_ENABLED=true

# Batas dan Lokasi Upload File (bukti transfer & foto produk)
MAX_UPLOAD_BYTES=2097152
UPLOAD_DIR=./uploads

# CORS (Frontend Next.js)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Next.js Frontend Public URL (untuk frontend/.env.local)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
